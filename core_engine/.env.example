# Local Ollama Settings (100% Free & Local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_OLLAMA_MODEL=qwen2.5-coder:7b

# Custom Kriti AI Cloud GPU Node (Google Colab or Hugging Face Space URL)
KRITIAI_CUSTOM_API_URL=https://your-colab-tunnel.trycloudflare.com
KRITIAI_CUSTOM_API_KEY=

# Cloud Fallback API Key (Free Groq or OpenRouter)
GROQ_API_KEY=gsk_your_free_groq_api_key_here
CLOUD_FALLBACK_API_URL=https://api.groq.com/openai/v1

# Gateway Sync Server Port
PORT=9876
GATEWAY_SECRET=kritiai-secure-sync-token
